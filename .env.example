# Langflow 本地开发环境变量模板
# 用法：复制为 .env，然后根据本机环境修改配置。
# 安全提示：不要把 .env、数据库密码、管理员密码或 API 密钥提交到 Git。

# ==================== 前端开发服务器 ====================
# 前端开发服务器监听地址。
VITE_HOST=0.0.0.0
# 前端开发服务器端口。
VITE_PORT=3000
# 前端请求后端 API 时使用的代理地址。
VITE_PROXY_TARGET=http://localhost:7860

# ==================== 登录 Cookie ====================
# 本地使用 HTTP 时应为 false；启用 HTTPS 时可设为 true。
LANGFLOW_REFRESH_SECURE=false
# Cookie 的跨站策略：本地开发通常使用 lax。
LANGFLOW_REFRESH_SAME_SITE=lax

# ==================== 配置与数据库 ====================
# 配置、日志和上传文件的存放目录；留空时使用默认目录。
LANGFLOW_CONFIG_DIR=
# 是否把数据库保存到配置目录；false 时使用项目/运行目录中的数据库位置。
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=false

# PostgreSQL 连接地址。请替换 your_password，不要提交真实密码。
LANGFLOW_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/langflow  # pragma: allowlist secret
# 是否把 Alembic 数据库迁移日志输出到控制台。
LANGFLOW_ALEMBIC_LOG_TO_STDOUT=false
# 数据库连接失败时是否自动重试。
LANGFLOW_DATABASE_CONNECTION_RETRY=false

# mem0 的聊天记录、向量库和其他产物目录；留空时使用默认目录。
# MEM0_DIR=~/.mem0
# Composio 文件上传和下载缓存目录；留空时使用默认目录。
# COMPOSIO_CACHE_DIR=~/.composio

# LangChain 缓存后端；当前本地配置使用 SQLiteCache。
LANGFLOW_LANGCHAIN_CACHE=SQLiteCache

# ==================== 后端服务 ====================
# 后端监听地址；留空时使用默认地址。
LANGFLOW_HOST=
# 工作进程数量。SQLite 只能使用 1；PostgreSQL 可按机器资源增加。
LANGFLOW_WORKERS=1
# 后端 API 端口。
LANGFLOW_PORT=7860
# 日志级别；留空时使用默认值，例如 DEBUG、INFO、WARNING。
LANGFLOW_LOG_LEVEL=
# 日志文件路径；留空时输出到控制台或使用默认路径。
LANGFLOW_LOG_FILE=
# 日志轮转配置；留空时使用默认值。
LANGFLOW_LOG_ROTATION=
# 已构建前端文件的目录；开发模式通常留空。
LANGFLOW_FRONTEND_PATH=
# 启动后是否自动打开浏览器。
LANGFLOW_OPEN_BROWSER=false
# 保存项目时是否移除其中的 API 密钥。
LANGFLOW_REMOVE_API_KEYS=false

# ==================== 缓存 ====================
# 缓存类型：async、memory 或 redis。本地开发使用 async 即可。
LANGFLOW_CACHE_TYPE=async
# 只有使用 Redis 缓存时才需要配置以下变量。
# LANGFLOW_REDIS_HOST=localhost
# LANGFLOW_REDIS_PORT=6379
# LANGFLOW_REDIS_DB=0
# LANGFLOW_REDIS_CACHE_EXPIRE=3600

# ==================== 登录与管理员 ====================
# 是否自动登录；false 时显示登录页，并要求设置管理员密码。
# 官方 release、源码归档和 Docker 镜像默认关闭自动登录；开发分支默认开启。
LANGFLOW_AUTO_LOGIN=false
# 是否允许通过 CLI 创建超级用户。
LANGFLOW_ENABLE_SUPERUSER_CLI=true
# 超级用户用户名。
LANGFLOW_SUPERUSER=admin
# 超级用户密码。请填写本地密码，不要提交真实密码。
LANGFLOW_SUPERUSER_PASSWORD=

# API Key 校验来源：db（数据库）或 env（LANGFLOW_API_KEY 环境变量）。
LANGFLOW_API_KEY_SOURCE=db
# 仅当 LANGFLOW_API_KEY_SOURCE=env 时使用；请勿提交真实 API Key。
LANGFLOW_API_KEY=

# ==================== 访问频率限制 ====================
# 每个 IP 每分钟允许的登录尝试次数。
LANGFLOW_RATE_LIMIT_PER_MINUTE=5
# 每个 IP 每分钟允许的匿名公开流程运行次数。
LANGFLOW_PUBLIC_FLOW_RATE_LIMIT_PER_MINUTE=20
# 频率限制计数器存储地址；留空使用单进程内存存储。
# 多实例部署时可设置为 redis://localhost:6379。
LANGFLOW_RATE_LIMIT_STORAGE_URI=
# 是否信任反向代理传递的 X-Forwarded-For。仅在可信代理后设为 true。
LANGFLOW_RATE_LIMIT_TRUST_PROXY=false

# ==================== 环境变量与安全 ====================
# 是否把环境变量保存到数据库；本地通常关闭。
LANGFLOW_STORE_ENVIRONMENT_VARIABLES=false
# 是否启用 SSRF 防护。生产环境建议启用；本地连接 localhost 时通常保持 false。
LANGFLOW_SSRF_PROTECTION_ENABLED=false
# SSRF 防护启用时允许的主机、IP 或 CIDR，逗号分隔。
LANGFLOW_SSRF_ALLOWED_HOSTS=

# ==================== MCP ====================
# 是否启用 MCP 项目中的 MCP Composer 功能。
LANGFLOW_MCP_COMPOSER_ENABLED=true
# 通道网关提供商下载大小上限，单位为字节；52428800 即 50 MiB。
LANGFLOW_CHANNEL_MAX_DOWNLOAD_BYTES=52428800

# MCP 会话管理参数；需要调整时取消注释并修改。
# LANGFLOW_MCP_SESSION_CLEANUP_INTERVAL=120
# LANGFLOW_MCP_SESSION_IDLE_TIMEOUT=400
# LANGFLOW_MCP_MAX_SESSIONS_PER_SERVER=10

# ==================== 可选服务 ====================
# Langflow Store 地址；不使用时留空。
# LANGFLOW_STORE_URL=
# 下载事件 Webhook；不使用时留空。
# LANGFLOW_DOWNLOAD_WEBHOOK_URL=
# 点赞事件 Webhook；不使用时留空。
# LANGFLOW_LIKE_WEBHOOK_URL=

# 后端地址；如填写，值必须以 / 结尾；开发代理模式通常留空。
BACKEND_URL=

# ==================== Starter Projects ====================
# 新注册用户是否自动激活；false 时需要管理员审批后激活。
LANGFLOW_NEW_USER_IS_ACTIVE=true
# 启动时是否用最新组件版本重建内置 Starter Projects。
# false 会保留已有模板，只补创建缺失模板，适合本地开发。
LANGFLOW_UPDATE_STARTER_PROJECTS=false
