# Same-host test overrides ONLY. Append after production.env.example to create
# deploy/.env; this fragment is not a complete standalone application template.
# Shared auth, keys and production behavior come from production.env.example.
# Use different stable hexadecimal passwords for these local dependencies.
POSTGRES_PASSWORD=replace-with-a-random-hex-password  # pragma: allowlist secret -- placeholder only
REDIS_PASSWORD=replace-with-another-random-hex-password  # pragma: allowlist secret -- placeholder only

# These names resolve on the openxflow_default Docker network.
LANGFLOW_DATABASE_URL=postgresql+psycopg://openxflow:${POSTGRES_PASSWORD}@postgres:5432/openxflow
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://openxflow:${POSTGRES_PASSWORD}@postgres:5432/openxflow

LANGFLOW_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
LANGFLOW_REDIS_QUEUE_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
LANGFLOW_RATE_LIMIT_STORAGE_URI=redis://:${REDIS_PASSWORD}@redis:6379/0

LANGFLOW_OBJECT_STORAGE_BUCKET_NAME=openxflow-test
AWS_ENDPOINT_URL=http://objectstore:8333
# Install aws-config.example at this path before starting the application.
AWS_CONFIG_FILE=/app/data/config/aws-config

# HTTP access through the SSH tunnel. Use the actual origin if changing ports.
LANGFLOW_ACCESS_SECURE=false
LANGFLOW_REFRESH_SECURE=false
LANGFLOW_CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860

# The API and dependency files intentionally manage different services under
# one Compose project. Suppress orphan notices without removing any containers.
COMPOSE_IGNORE_ORPHANS=true
