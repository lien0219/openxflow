# Copy to deploy/.env on the production host. Keep the copy out of Git.
OPENXFLOW_BIND_ADDRESS=127.0.0.1
OPENXFLOW_PORT=7860
OPENXFLOW_DATA_DIR=./data

# The deployment script replaces this value for each release.
OPENXFLOW_IMAGE=ghcr.io/lien0219/openxflow:main-v0.1.0

LANGFLOW_DEPLOYMENT_PROFILE=prod
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_NEW_USER_IS_ACTIVE=false

LANGFLOW_DATABASE_URL=postgresql+psycopg://openxflow:replace-me@db.example.invalid:5432/openxflow  # pragma: allowlist secret -- placeholder only
LANGFLOW_SECRET_KEY=replace-with-a-Fernet-key-generated-for-this-installation  # pragma: allowlist secret -- placeholder only
LANGFLOW_STORAGE_TYPE=s3
LANGFLOW_OBJECT_STORAGE_BUCKET_NAME=openxflow-production
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://openxflow:replace-me@vector.example.invalid:5432/openxflow  # pragma: allowlist secret -- placeholder only

LANGFLOW_CACHE_TYPE=redis
LANGFLOW_REDIS_URL=rediss://:replace-me@redis.example.invalid:6380/0  # pragma: allowlist secret -- placeholder only
LANGFLOW_JOB_QUEUE_TYPE=redis
LANGFLOW_REDIS_QUEUE_URL=rediss://:replace-me@redis.example.invalid:6380/0  # pragma: allowlist secret -- placeholder only
LANGFLOW_RATE_LIMIT_STORAGE_URI=rediss://:replace-me@redis.example.invalid:6380/0  # pragma: allowlist secret -- placeholder only
LANGFLOW_CACHE_SIGNING_KEY=replace-with-a-stable-cache-signing-key  # pragma: allowlist secret -- placeholder only

AWS_ACCESS_KEY_ID=replace-me  # pragma: allowlist secret -- placeholder only
AWS_SECRET_ACCESS_KEY=replace-me  # pragma: allowlist secret -- placeholder only
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=https://s3.example.invalid
AWS_S3_FORCE_PATH_STYLE=false

# Optional production controls.
LANGFLOW_LOG_LEVEL=INFO
LANGFLOW_SSRF_PROTECTION_ENABLED=true
