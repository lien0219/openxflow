# Base application configuration for production, including future API replicas.
# Copy to deploy/.env and replace all placeholders. Keep the copy out of Git.
# Early same-host tests append single-node.env.example after this template.
# Replica count and rollout strategy belong to the deployment configuration.

# Host-local Compose settings; each future API host keeps its own data directory.
OPENXFLOW_BIND_ADDRESS=127.0.0.1
OPENXFLOW_PORT=7860
OPENXFLOW_DATA_DIR=./data

# Example only: use an actually published immutable version, SHA tag, or digest.
# The deployment script replaces this value for each release.
OPENXFLOW_IMAGE=ghcr.io/lien0219/openxflow:main-v0.1.0

LANGFLOW_DEPLOYMENT_PROFILE=prod
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_NEW_USER_IS_ACTIVE=false
LANGFLOW_ENABLE_SIGNUP=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password  # pragma: allowlist secret -- placeholder only

# Keep both keys stable and identical across all API replicas and listeners.
LANGFLOW_SECRET_KEY=replace-with-a-Fernet-key-generated-for-this-installation  # pragma: allowlist secret -- placeholder only
LANGFLOW_CACHE_SIGNING_KEY=replace-with-a-stable-cache-signing-key  # pragma: allowlist secret -- placeholder only
LANGFLOW_STORE_ENVIRONMENT_VARIABLES=false

# Public production access uses HTTPS. HTTP-only tests override both to false.
LANGFLOW_ACCESS_SECURE=true
LANGFLOW_REFRESH_SECURE=true
# Exact browser origin(s), comma-separated; include a port when nonstandard.
LANGFLOW_CORS_ORIGINS=https://openxflow.example.invalid

# Shared application database and vector store, reachable by every API replica.
# Configure PostgreSQL TLS/CA options in these URLs when required by the provider.
LANGFLOW_DATABASE_URL=postgresql+psycopg://openxflow:replace-me@db.example.invalid:5432/openxflow  # pragma: allowlist secret -- placeholder only
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://openxflow:replace-me@vector.example.invalid:5432/openxflow  # pragma: allowlist secret -- placeholder only
# Per-process application-engine pool. Budget across all replicas/workers and
# reserve additional connections for vector queries, telemetry and migrations.
LANGFLOW_DB_CONNECTION_SETTINGS={"pool_size":20,"max_overflow":30,"pool_timeout":30,"pool_pre_ping":true,"pool_recycle":1800,"echo":false}
LANGFLOW_MIGRATION_LOCK_TIMEOUT_S=300

# Use the same cache, build-event queue and rate-limit stores across replicas.
# The current deployment helper requires DB 0. Separate Redis endpoints may be used.
LANGFLOW_CACHE_TYPE=redis
LANGFLOW_REDIS_URL=rediss://:replace-me@redis.example.invalid:6380/0  # pragma: allowlist secret -- placeholder only
LANGFLOW_JOB_QUEUE_TYPE=redis
LANGFLOW_REDIS_QUEUE_URL=rediss://:replace-me@redis.example.invalid:6380/0  # pragma: allowlist secret -- placeholder only
LANGFLOW_RATE_LIMIT_STORAGE_URI=rediss://:replace-me@redis.example.invalid:6380/0  # pragma: allowlist secret -- placeholder only
LANGFLOW_RATE_LIMIT_ENABLED=true
# Enable only behind a trusted proxy that overwrites forwarded client headers
# and prevents clients from reaching the API directly.
LANGFLOW_RATE_LIMIT_TRUST_PROXY=false

# Shared object store and bucket. Provision the bucket before application startup.
LANGFLOW_STORAGE_TYPE=s3
LANGFLOW_OBJECT_STORAGE_BUCKET_NAME=openxflow-production
AWS_ACCESS_KEY_ID=replace-me  # pragma: allowlist secret -- placeholder only
AWS_SECRET_ACCESS_KEY=replace-me  # pragma: allowlist secret -- placeholder only
AWS_DEFAULT_REGION=us-east-1
# Leave empty for the standard AWS S3 endpoint.
AWS_ENDPOINT_URL=https://s3.example.invalid
# For a path-style S3 endpoint, install aws-config.example under data/config
# and enable the following setting. The SDK reads addressing_style from it.
# AWS_CONFIG_FILE=/app/data/config/aws-config

# Background jobs currently execute inside each API worker; Redis shares build
# events but does not install the absent standalone background worker backend.
LANGFLOW_BACKGROUND_MAX_CONCURRENCY=5
LANGFLOW_BACKGROUND_LEASE_TTL_S=45
LANGFLOW_BACKGROUND_HEARTBEAT_INTERVAL_S=15
LANGFLOW_BACKGROUND_WATCHDOG_INTERVAL_S=15
# Optional execution timeout in seconds; choose for the longest permitted flow.
# LANGFLOW_BACKGROUND_JOB_TIMEOUT=1800
# 0 preserves terminal job history. A positive value purges old terminal jobs
# and ends their idempotency protection; choose a retention policy before changing.
LANGFLOW_BACKGROUND_RETENTION_DAYS=0

# Track B provider connections need a separate `langflow listeners` service.
# See listeners/README.md; API replicas keep subprocess listeners disabled.
LANGFLOW_LISTENERS_MODE=off

LANGFLOW_LOG_LEVEL=INFO
LANGFLOW_SSRF_PROTECTION_ENABLED=true
# If connectors intentionally call private hosts, allow only the required hosts.
# LANGFLOW_SSRF_ALLOWED_HOSTS=llm-gateway.corp.example
# When enabled, arrange private scraping of port 9090 in the deployment config.
LANGFLOW_PROMETHEUS_ENABLED=false
# Optional durable audit history; review the retention policy before enabling.
# LANGFLOW_AUDIT_ENABLED=true
# LANGFLOW_AUDIT_RETENTION_DAYS=90
